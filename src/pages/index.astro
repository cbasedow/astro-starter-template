---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Astro Starter">
  <main
    class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-16"
  >
    <p class="text-sm font-medium text-zinc-400">Astro Starter Template</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Ready to build.</h1>
    <p class="mt-4 max-w-xl text-lg text-zinc-400">
      Tailwind CSS, Prettier, and ESLint are configured. Edit
      <code class="rounded bg-zinc-900 px-1.5 py-0.5 text-sm text-zinc-200"
        >src/pages/index.astro</code
      >
      or add pages with
      <code class="rounded bg-zinc-900 px-1.5 py-0.5 text-sm text-zinc-200"
        >src/layouts/BaseLayout.astro</code
      >.
    </p>
  </main>
</BaseLayout>
